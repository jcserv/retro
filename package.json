{
  "name": "retro",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc -b",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:workers && npm run build && npm run test:e2e"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0",
    "preact-iso": "^2.12.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "happy-dom": "^20.14.5",
    "preact-render-to-string": "^6.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true,
    "fsevents": false
  }
}
