{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retro",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "AI_BUDGET", "class_name": "AiBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["AiBudget"] }
  ],
  "ai": { "binding": "AI", "remote": true },
  "vars": { "AI_SUGGESTIONS": "on" },
  "ratelimits": [
    {
      "name": "CREATE_ROOM_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AI_SUGGEST_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
